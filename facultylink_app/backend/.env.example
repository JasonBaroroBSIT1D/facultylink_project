FLASK_SECRET_KEY=change-this-for-production
JWT_SECRET_KEY=change-this-jwt-secret-use-at-least-32-characters
UPLOAD_FOLDER=uploads

# Required. FacultyLink uses PostgreSQL only (SQLite is disabled).
DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@127.0.0.1:5432/facultylink

# Optional isolated DB for pytest (defaults to facultylink_test).
# TEST_DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@127.0.0.1:5432/facultylink_test
