FLASK_SECRET_KEY=change-this-for-production
JWT_SECRET_KEY=change-this-jwt-secret-use-at-least-32-characters
UPLOAD_FOLDER=uploads

# Default local file database (no extra install):
# DATABASE_URL=sqlite:///facultylink.db

# PostgreSQL 18 on this machine. Replace YOUR_PASSWORD with the postgres user password
# you set when PostgreSQL was installed.
DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@127.0.0.1:5432/facultylink
